# 로컬 실행용 — 실제 값은 .env.local에 (커밋 금지, CLAUDE.md 규칙 6)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
YOUTUBE_API_KEY=
YT_CHANNEL=@핸들또는UC채널ID

# 레이트리밋 (보안감사 M-2) — Vercel Marketplace의 Upstash Redis 연동.
# 둘 다 비어 있으면 레이트리밋 비활성(fail-open) — 로컬에선 없어도 정상 동작.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
